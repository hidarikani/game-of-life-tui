{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "request": "launch",
      "name": "Interactive (VSCode)",
      "type": "node",
      "program": "${workspaceFolder}/mod.ts",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "/opt/homebrew/bin/deno",
      "runtimeArgs": [
        "run",
        "--inspect-wait",
        "--allow-env",
        "--allow-read",
        "--allow-write"
      ],
      "args": ["--interactive=true", "--pattern=pulsar"],
      // Ink needs a real TTY for raw-mode input and terminal size.
      "console": "integratedTerminal",
      "attachSimplePort": 9229
    },
    {
      // Attaches to an app started in an external terminal, e.g.:
      //   deno run --inspect-wait --allow-env --allow-read --allow-write \
      //     mod.ts --interactive=true --pattern=pulsar
      "request": "attach",
      "name": "Interactive (external)",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "address": "127.0.0.1",
      "port": 9229
    },
    {
      "request": "launch",
      "name": "Non-interactive (3 generations)",
      "type": "node",
      "program": "${workspaceFolder}/mod.ts",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "/opt/homebrew/bin/deno",
      "runtimeArgs": [
        "run",
        "--inspect-wait",
        "--allow-env",
        "--allow-read",
        "--allow-write"
      ],
      "args": [
        "--interactive=false",
        "--pattern=pulsar",
        "--grid-width=17",
        "--grid-height=17",
        "--generations=3"
      ],
      "console": "integratedTerminal",
      "attachSimplePort": 9229
    },
    {
      "request": "launch",
      "name": "Tests",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "/opt/homebrew/bin/deno",
      "runtimeArgs": ["test", "--inspect-wait", "--allow-env"],
      "console": "integratedTerminal",
      "attachSimplePort": 9229
    }
  ]
}
